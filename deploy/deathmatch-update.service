[Unit]
Description=AI Options Deathmatch fill and mark update
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/ai-options-deathmatch
ExecStart=/usr/bin/python3 /opt/ai-options-deathmatch/scheduled_update.py
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ai-options-deathmatch /var/lib/ai-options-deathmatch-public /run/lock
