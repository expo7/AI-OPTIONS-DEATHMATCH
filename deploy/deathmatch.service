[Unit]
Description=AI Options Deathmatch public site
After=network.target

[Service]
User=deploy
Group=deploy
WorkingDirectory=/opt/ai-options-deathmatch
Environment=PORT=8000
EnvironmentFile=-/etc/ai-options-deathmatch.env
ExecStart=/usr/bin/python3 /opt/ai-options-deathmatch/app.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
